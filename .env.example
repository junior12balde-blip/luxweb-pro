# Site
NEXT_PUBLIC_SITE_URL=https://luxwebpro.lu

# Contact & quote form email delivery (optional — via Resend, https://resend.com)
# Without RESEND_API_KEY, submissions are only logged to the server console.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="LuxWeb Pro <onboarding@resend.dev>"
# Recipient for both the contact form (/contacto) and quote requests (/orcamento).
CONTACT_EMAIL=contact@luxwebpro.lu

# Google Maps (optional — only needed if you swap the embed iframe for the JS API)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Analytics 4 (optional). Only loads after a visitor accepts the
# cookie consent banner (GDPR — see src/components/CookieConsent.tsx).
# Get this from analytics.google.com > Admin > Data Streams > your stream.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console site verification (optional). Get this from
# search.google.com/search-console > Settings > Ownership verification >
# HTML tag method — copy just the `content` value, not the whole tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
