// Esquema de la Fase 1 (usuarios, propiedades, membresías) + Fase 2 (perfil
// de usuario, propiedades avanzadas con fotos) + Fase 3 (asistente de IA
// para huéspedes: Conversation/Message) + Fase 4 (generador de anuncios:
// ListingDraft) + Fase 5 (generador de vídeos: MediaGeneration) + Fase 6
// (generador de imágenes, mismo modelo MediaGeneration con type: IMAGE) +
// Fase 7 (automatizaciones: Automation/AutomationRun, y checkInDate/
// checkOutDate en Conversation para saber cuándo dispararlas) + Fase 9
// (facturación: Subscription, FK 1:1 a User — la Fase 8, Analítica, se
// dejó pendiente a petición explícita del cliente, que pidió saltar
// directo a facturación).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PropertyType {
  APARTMENT
  HOUSE
  ROOM
  STUDIO
  VILLA
  OTHER
}

enum MembershipRole {
  OWNER
  EDITOR
  VIEWER
}

enum ConversationStatus {
  OPEN
  CLOSED
}

enum MessageSender {
  GUEST
  HOST
  ASSISTANT
}

enum MediaType {
  VIDEO
  IMAGE
}

enum MediaGenerationStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

/// Tipo de recordatorio automático. Cada uno se calcula relativo a la fecha
/// de check-in o de check-out de una Conversation (ver ANCHOR_FIELD en
/// src/lib/automations/types.ts) — WELCOME_MESSAGE y CHECKIN_REMINDER
/// respecto a checkInDate; CHECKOUT_REMINDER, POST_STAY_FOLLOWUP y
/// REVIEW_REQUEST respecto a checkOutDate.
enum AutomationType {
  WELCOME_MESSAGE
  CHECKIN_REMINDER
  CHECKOUT_REMINDER
  POST_STAY_FOLLOWUP
  REVIEW_REQUEST
}

enum AutomationRunStatus {
  /// Ya llegó su hora y el anfitrión aún no lo ha marcado como hecho.
  DUE
  /// El anfitrión confirmó que ya actuó (envió el mensaje, pidió la reseña...).
  DONE
  /// El anfitrión decidió descartarlo para esta conversación.
  DISMISSED
}

/// Plan de suscripción — ver src/lib/billing/plans.ts para límites y
/// etiquetas. `FREE` es el plan implícito: un usuario sin fila en
/// `Subscription` se trata como FREE (ver src/lib/billing/subscription.ts),
/// así que no hace falta un backfill al añadir este modelo.
enum PlanId {
  FREE
  STARTER
  PRO
  BUSINESS
}

/// Estado de una suscripción de Stripe — mismo vocabulario que
/// `Stripe.Subscription.Status` (ver node_modules/stripe), para no tener
/// que traducir entre dos vocabularios distintos al procesar webhooks.
enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
  PAUSED
}

/// Usuario de la aplicación. Se crea automáticamente en el primer login a
/// partir del usuario de Supabase Auth (ver src/lib/auth.ts).
model User {
  id          String       @id @default(cuid())
  authId      String       @unique
  email       String       @unique
  fullName    String?
  avatarUrl   String?
  /// Código de idioma preferido (es, en, fr, de, pt) — ver LOCALES en
  /// src/lib/validations/profile.ts.
  locale      String       @default("es")
  /// Nombre de zona horaria IANA (ej. "Europe/Madrid").
  timezone    String       @default("UTC")
  /// Preferencias de notificaciones — forma definida por
  /// NotificationPreferences en src/lib/validations/profile.ts. `null`
  /// significa "usar los valores por defecto".
  notificationPrefs Json?
  /// Preferencias de IA del anfitrión (proveedor por defecto, tono, etc.) —
  /// forma definida por AIPreferences en src/lib/ai/types.ts. Reservado
  /// para las Fases 3+; en la Fase 2 solo se guarda la preferencia de
  /// proveedor, sin hacer ninguna llamada real a IA.
  aiPreferences     Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  subscription Subscription?

  @@map("users")
}

/// Suscripción de facturación de un anfitrión (Fase 9). Uno por `User` — no
/// hay concepto de "organización" en la app, así que quien paga es la
/// misma persona que gestiona las propiedades. Si no existe fila, el
/// usuario se trata como plan `FREE` activo (ver
/// src/lib/billing/subscription.ts) — no se crea una fila hasta que el
/// usuario se suscribe de verdad vía Stripe Checkout.
model Subscription {
  id                   String             @id @default(cuid())
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String             @unique
  plan                 PlanId             @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  /// Fin del período de facturación actual — `null` si nunca se ha creado
  /// una suscripción real en Stripe.
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("subscriptions")
}

/// Alojamiento gestionado por uno o más anfitriones.
model Property {
  id            String       @id @default(cuid())
  name          String
  type          PropertyType @default(APARTMENT)
  address       String
  city          String
  country       String
  maxGuests     Int          @default(1)
  bedrooms      Int          @default(1)
  bathrooms     Int          @default(1)
  nightlyPrice  Decimal      @db.Decimal(10, 2)
  currency      String       @default("EUR")
  description   String?
  /// Si es `false`, la propiedad se conserva pero se trata como archivada
  /// (no se muestra como activa en listados/analítica futura).
  active        Boolean      @default(true)
  amenities     String[]     @default([])
  houseRules    String?
  /// Hora local en formato "HH:mm" (ej. "15:00"). No es un horario por día
  /// de la semana — eso pertenece a una fase futura de disponibilidad.
  checkInTime   String?
  checkOutTime  String?
  /// Activa el asistente de IA (sugerencia de respuestas) para esta
  /// propiedad. Apagado por defecto — el anfitrión debe activarlo a
  /// propósito.
  aiAssistantEnabled Boolean @default(false)
  /// Descripción libre del tono deseado (ej. "cercano y profesional, con
  /// algo de humor"), usada como instrucción del sistema al generar
  /// sugerencias. `null` usa un tono neutro por defecto.
  aiAssistantTone    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  memberships   Membership[]
  photos        PropertyPhoto[]
  conversations Conversation[]
  listingDrafts ListingDraft[]
  mediaGenerations MediaGeneration[]
  automations   Automation[]

  @@map("properties")
}

/// Configuración de un recordatorio automático para una propiedad — a lo
/// sumo uno por (propiedad, tipo), ver @@unique. No envía nada por sí
/// mismo (no hay proveedor de email configurado todavía — ver PHASE-7.md):
/// solo decide cuándo generar un AutomationRun para que el anfitrión lo vea
/// y actúe desde el dashboard.
model Automation {
  id              String              @id @default(cuid())
  property        Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId      String
  type            AutomationType
  enabled         Boolean             @default(false)
  /// Horas relativas a la fecha ancla del tipo (negativo = antes, positivo
  /// = después) — ver ANCHOR_FIELD en src/lib/automations/types.ts.
  offsetHours     Int
  /// Plantilla con placeholders {{guestName}} / {{propertyName}} — ver
  /// src/lib/automations/templates.ts.
  messageTemplate String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  runs            AutomationRun[]

  @@unique([propertyId, type])
  @@map("automations")
}

/// Una ejecución concreta de una Automation para una Conversation (huésped)
/// específica. Se crea la primera vez que se cumple su hora — @@unique
/// evita duplicados si el cron se ejecuta más de una vez sobre el mismo
/// vencimiento.
model AutomationRun {
  id             String              @id @default(cuid())
  automation     Automation          @relation(fields: [automationId], references: [id], onDelete: Cascade)
  automationId   String
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  status         AutomationRunStatus @default(DUE)
  scheduledFor   DateTime
  /// Mensaje ya renderizado (placeholders sustituidos) en el momento de crearse.
  message        String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([automationId, conversationId])
  @@index([conversationId])
  @@map("automation_runs")
}

/// Un vídeo (Fase 5) o imagen (Fase 6, mismo modelo con `type: IMAGE`)
/// generado por IA para una propiedad. La generación es asíncrona: se crea
/// en `PENDING`, pasa a `PROCESSING` al confirmar el proveedor que empezó a
/// trabajar, y termina en `READY` (con `resultUrl`) o `FAILED` (con
/// `errorMessage`). `providerJobId` es el identificador que da el
/// proveedor (ej. el nombre de la operación de Veo) para poder consultar
/// su estado más tarde.
model MediaGeneration {
  id            String                 @id @default(cuid())
  property      Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId    String
  type          MediaType
  status        MediaGenerationStatus  @default(PENDING)
  prompt        String
  /// Proveedor y modelo que generan este medio (ej. "google" / "veo-3.0-generate-001").
  provider      String
  model         String
  providerJobId String?
  resultUrl     String?
  errorMessage  String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([propertyId])
  @@map("media_generations")
}

/// Versión generada (o editada) de la copia del anuncio de una propiedad:
/// título, descripción, puntos destacados y palabras clave SEO. Cada
/// generación crea una fila nueva — nunca se sobrescribe una anterior — para
/// conservar el historial. `isApplied` marca cuál usa el anfitrión ahora.
model ListingDraft {
  id          String   @id @default(cuid())
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId  String
  title       String
  description String
  highlights  String[] @default([])
  seoKeywords String[] @default([])
  /// Proveedor y modelo de IA que generaron esta versión (ej. "anthropic" /
  /// "claude-opus-4-8") — trazabilidad, no afecta el comportamiento.
  provider    String
  model       String
  isApplied   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([propertyId])
  @@map("listing_drafts")
}

/// Hilo de mensajes con un huésped de una propiedad. En esta fase no hay
/// integración con ningún canal externo (Airbnb/email/WhatsApp): el
/// anfitrión registra manualmente los mensajes del huésped.
model Conversation {
  id          String             @id @default(cuid())
  property    Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId  String
  guestName   String?
  status      ConversationStatus @default(OPEN)
  /// Fechas de la estadia del huésped, introducidas manualmente por el
  /// anfitrión (no hay integración con ningún canal externo todavía) —
  /// `null` si no se conocen. Usadas por las automatizaciones de la Fase 7
  /// para saber cuándo disparar cada recordatorio.
  checkInDate  DateTime?
  checkOutDate DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  messages    Message[]
  automationRuns AutomationRun[]

  @@index([propertyId])
  @@map("conversations")
}

/// Un mensaje dentro de una Conversation. `ASSISTANT` son sugerencias
/// generadas por IA que el anfitrión aún no ha confirmado como enviadas;
/// al confirmarlas se guardan como un mensaje `HOST` nuevo.
model Message {
  id             String        @id @default(cuid())
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         MessageSender
  content        String
  /// El anfitrión marcó este mensaje (solo tiene sentido si sender = HOST)
  /// como ejemplo de su estilo de escritura — se usa como *few-shot
  /// example* al generar sugerencias futuras en la misma propiedad.
  isStyleExample Boolean       @default(false)
  createdAt      DateTime      @default(now())

  @@index([conversationId])
  @@map("messages")
}

/// Fotografía de una propiedad, subida a Supabase Storage (bucket
/// `property-photos`). `position` controla el orden de la galería.
model PropertyPhoto {
  id         String   @id @default(cuid())
  url        String
  alt        String?
  position   Int      @default(0)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  createdAt  DateTime @default(now())

  @@index([propertyId])
  @@map("property_photos")
}

/// Relación usuario↔propiedad con rol. Un usuario puede gestionar varias
/// propiedades y una propiedad puede tener varios anfitriones (equipo).
model Membership {
  id         String         @id @default(cuid())
  role       MembershipRole @default(OWNER)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  property   Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  propertyId String
  createdAt  DateTime       @default(now())

  @@unique([userId, propertyId])
  @@map("memberships")
}
