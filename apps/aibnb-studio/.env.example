# ── Base de datos (Fase 1) ───────────────────────────────────────────────
# Con docker-compose local (docker compose up -d):
DATABASE_URL="postgresql://aibnb:aibnb@localhost:5432/aibnb_studio"
DIRECT_URL="postgresql://aibnb:aibnb@localhost:5432/aibnb_studio"
#
# Con Supabase (producción / staging): crea un proyecto en
# https://supabase.com/dashboard → Settings → Database → Connection string.
# DATABASE_URL = conexión vía *pooler* (puerto 6543, con ?pgbouncer=true) para
# runtime. DIRECT_URL = conexión directa (puerto 5432) usada solo por
# `prisma migrate`.

# ── Supabase Auth + Storage (Fase 1 y 2) ────────────────────────────────
# Crea un proyecto en https://supabase.com/dashboard y copia estos valores
# desde Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://<tu-proyecto>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"
# Clave privada de servidor — nunca la expongas al cliente ni la commitees.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
# Fase 2: sube foto de perfil y fotos de propiedad a Supabase Storage — hace
# falta crear los buckets `avatars` y `property-photos` (SQL en PHASE-2.md).

# ── Sitio (Fase 2, opcional) ─────────────────────────────────────────────
# URL pública usada en los enlaces de los emails de Supabase (confirmación,
# recuperación de contraseña). Sin ella se deriva de las cabeceras de la
# petición — solo hace falta fijarla si eso da problemas en tu despliegue.
# NEXT_PUBLIC_SITE_URL="https://app.aibnb.studio"

# ── IA de texto ──────────────────────────────────────────────────────────
# AI_DEFAULT_PROVIDER: proveedor por defecto de la instancia (no es secreta).
# AI_DEFAULT_PROVIDER="anthropic"
#
# ANTHROPIC_API_KEY — REQUERIDA desde la Fase 3 para que "Sugerir respuesta"
# (asistente de IA para huéspedes) funcione. Crear en
# https://console.anthropic.com/ → API Keys. Sin ella, ese botón muestra un
# error claro ("proveedor no configurado") — el resto de la app funciona igual.
# ANTHROPIC_API_KEY=""
#
# OPENAI_API_KEY — arquitectura lista desde la Fase 2, proveedor de texto
# alternativo aún no activado (nadie lo ha pedido). Si falta, simplemente
# aparece como "No configurado" en /dashboard/settings/integrations.
# OPENAI_API_KEY: crear en https://platform.openai.com/api-keys
# OPENAI_API_KEY=""

# ── IA de vídeo e imagen (Fases 5 y 6) ──────────────────────────────────
# GOOGLE_AI_API_KEY — REQUERIDA desde la Fase 5 para que "Generar vídeo"
# (Veo) funcione, y desde la Fase 6 para "Generar imagen" (Imagen) — misma
# clave para ambos, mismo SDK @google/genai. Misma clave que la de arriba
# si también activas Google como proveedor de texto — es la misma API.
# Crear en https://aistudio.google.com/apikey. Sin ella, esos botones
# muestran un error claro ("proveedor no configurado") — el resto de la
# app funciona igual.
# GOOGLE_AI_API_KEY=""
#
# GEMINI_VIDEO_MODEL (opcional) — fija una versión de Veo distinta a la
# por defecto (veo-2.0-generate-001) sin tocar código.
# GEMINI_VIDEO_MODEL=""
#
# GEMINI_IMAGE_MODEL (opcional) — fija una versión de Imagen distinta a la
# por defecto (imagen-4.0-generate-001) sin tocar código.
# GEMINI_IMAGE_MODEL=""
#
# Fase 5: sube los vídeos generados a Supabase Storage — hace falta crear el
# bucket `generated-videos` (SQL en PHASE-5.md).
# Fase 6: sube las imágenes generadas a Supabase Storage — hace falta crear
# el bucket `generated-images` (SQL en PHASE-6.md).

# ── Automatizaciones (Fase 7) ───────────────────────────────────────────
# CRON_SECRET — REQUERIDA desde la Fase 7 para que el cron de recordatorios
# funcione (/api/cron/automations). No es la clave de ningún proveedor
# externo: genérala tú mismo, por ejemplo con `openssl rand -hex 32`. Debe
# coincidir con el secreto de GitHub Actions AIBNB_CRON_SECRET (ver
# PHASE-7.md) — sin ella, el endpoint responde 503 y el cron falla
# explícitamente en vez de en silencio.
# CRON_SECRET=""

# ── Facturación (Fase 9) ─────────────────────────────────────────────────
# STRIPE_SECRET_KEY — REQUERIDA desde la Fase 9 para que "Suscribirse" y
# "Gestionar facturación" funcionen. Crear en
# https://dashboard.stripe.com/apikeys (usa la clave de modo test para
# desarrollo). Sin ella, esos botones muestran un error claro ("Stripe no
# está configurado") — el resto de la app (incluido el límite de
# propiedades del plan Gratis) funciona igual.
# STRIPE_SECRET_KEY=""
#
# STRIPE_WEBHOOK_SECRET — REQUERIDA para que /api/webhooks/stripe verifique
# que las notificaciones vienen de verdad de Stripe. Crear un endpoint en
# https://dashboard.stripe.com/webhooks apuntando a
# <tu-dominio>/api/webhooks/stripe (eventos: checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted,
# invoice.payment_failed) — o usa `stripe listen --forward-to
# localhost:3000/api/webhooks/stripe` (Stripe CLI) en desarrollo, que te da
# un secreto de test al vuelo.
# STRIPE_WEBHOOK_SECRET=""
#
# STRIPE_PRICE_STARTER / STRIPE_PRICE_PRO / STRIPE_PRICE_BUSINESS — Price ID
# de cada plan de pago, específicos de tu cuenta de Stripe (no inventados
# aquí). Crea un producto recurrente por plan en el Dashboard de Stripe →
# Product catalog y copia su Price ID (price_...). Sin uno de ellos, ese
# plan concreto no se puede contratar (los demás siguen funcionando).
# STRIPE_PRICE_STARTER=""
# STRIPE_PRICE_PRO=""
# STRIPE_PRICE_BUSINESS=""
#
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY — reservada, no usada todavía (el
# checkout actual redirige a una página alojada por Stripe, sin Stripe.js
# en el cliente).
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
